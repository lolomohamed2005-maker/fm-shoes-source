# Application URL
APP_URL="http://localhost:3000"

# PostgreSQL Database Configuration
# In production (e.g. Supabase, Neon, Railway, Cloud SQL, AWS RDS):
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"
# Or individual connection parameters:
# SQL_HOST="localhost"
# SQL_USER="postgres"
# SQL_PASSWORD="your_password"
# SQL_DB_NAME="footwear_store"
# SQL_PORT=5432

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-another-secure-secret"

# Initial Super Admin (Phone & Password seeded on first run)
ADMIN_INITIAL_PHONE="01010574689"
ADMIN_INITIAL_PASSWORD="your_secure_password_here"

# Image Storage Provider: 'local' (built-in persistent disk), 'cloudinary', or 's3'
STORAGE_PROVIDER="local"

# Cloudinary Storage Configuration (Optional - if using Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Amazon S3 / Supabase S3 Storage Configuration (Optional - if using S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Server Environment
NODE_ENV="production"
PORT=3000

